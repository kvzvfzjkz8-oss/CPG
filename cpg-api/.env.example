# ─── Serveur ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Base de données PostgreSQL ────────────────────────────
DATABASE_URL=postgresql://cpg:motdepasse@localhost:5432/cpg

# ─── Secrets JWT ───────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NE JAMAIS committer les vraies valeurs.
JWT_SECRET=changez-moi
JWT_REFRESH_SECRET=changez-moi-aussi
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── Origines autorisées (back-office) ─────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Notifications push (Expo) ─────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ─── Mobile Money ──────────────────────────────────────────
# Identifiants marchands fournis par les opérateurs.
# Ils vivent ICI, sur le serveur, jamais dans l'application mobile.
# Airtel Money — https://developers.airtel.africa/
# Sandbox (identifiants immédiats, sans KYC) : https://openapiuat.airtel.africa
# Production (après validation KYC par Airtel) : https://openapi.airtel.africa
AIRTEL_API_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# PIN marchand et clé publique RSA, nécessaires aux décaissements uniquement.
AIRTEL_MERCHANT_PIN=
AIRTEL_PUBLIC_KEY=
MOOV_API_URL=
MOOV_CLIENT_ID=
MOOV_CLIENT_SECRET=
MOMO_WEBHOOK_SECRET=changez-moi
